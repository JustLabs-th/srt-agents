{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "company.request.v1",
  "description": "Immutable request record stored as a thread attachment (docs/02_REQUEST_MODEL.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "requested_by_user_id", "request_type", "project_id", "description", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "requested_by_user_id": { "type": "string", "minLength": 1 },
    "request_type": { "enum": ["NEW_PROJECT", "MODIFY_PROJECT"] },
    "change_type": { "enum": ["FEATURE", "MODIFY_FEATURE", "BUGFIX", "REFACTOR", "PERFORMANCE", "MIGRATION", "MAINTENANCE"] },
    "project_id": { "type": ["string", "null"], "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "request_type": { "const": "NEW_PROJECT" } } },
      "then": { "properties": { "project_id": { "type": "null" } }, "not": { "required": ["change_type"] } },
      "else": { "required": ["change_type"], "properties": { "project_id": { "type": "string" } } }
    }
  ]
}
